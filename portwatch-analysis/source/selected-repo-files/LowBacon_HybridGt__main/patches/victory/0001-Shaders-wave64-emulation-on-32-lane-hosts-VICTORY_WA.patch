+        assert_eq!(uniform_blocks(&line), [true, true]);
+        let diamond = cfg(&[branch(1, 2), Exit::Jump(3), Exit::Jump(3), Exit::End]);
+        assert_eq!(uniform_blocks(&diamond), [true, false, false, true]);
+        let early = cfg(&[branch(1, 2), Exit::End, Exit::Jump(3), Exit::End]);
+        assert_eq!(uniform_blocks(&early), [true, false, false, false]);
+        let looped = cfg(&[Exit::Jump(1), Exit::Jump(2), branch(1, 3), Exit::End]);
+        assert_eq!(uniform_blocks(&looped), [true, false, false, true]);
+        let endless = cfg(&[Exit::Jump(1), Exit::Jump(1)]);
