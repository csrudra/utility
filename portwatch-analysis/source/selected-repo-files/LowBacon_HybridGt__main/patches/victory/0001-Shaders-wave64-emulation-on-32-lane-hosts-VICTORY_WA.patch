+    // ---- emulated console waves (see `Emulated`) ----
+
+    /// The flat thread index, the console lane and the flat index of the
+    /// console wave's first lane, made in the entry block.
+    fn console_ids(&mut self) -> (V, V, V) {
+        if let Some(ids) = self.emulated.as_ref().and_then(|e| e.ids) {
+            return ids;
+        }
+        let flat = self.mesh_thread();
+        let e = self.s.entry;
+        let (k63, not63) = (self.s.m.i32(63), self.s.m.i32(!63));
+        let lane = self.s.m.bin(e, Bin::And, flat, k63);
+        let base = self.s.m.bin(e, Bin::And, flat, not63);
+        let ids = (flat, lane, base);
+        if let Some(em) = self.emulated.as_mut() {
+            em.ids = Some(ids);
+        }
+        ids
+    }
+
+    /// Whether an exchange can be made where the instruction being lowered
+    /// stands: in a block every thread runs once, outside lane guards.
+    // shortcut: an instruction under a lane guard is refused although only
+    // its result is guarded; allow it once guarded regions are told apart.
+    fn exchange_site(&self) -> Result<(), Why> {
+        let em = self.emulated.as_ref().expect("emulated");
+        let guard = self
+            .cur_i
+            .is_some_and(|i| self.x.st.guards[self.cur_ir][i].is_some());
+        if guard || self.guarded != 0 || !em.uniform[self.cur_ir] {
+            return Err(NOT_UNIFORM);
+        }
+        Ok(())
+    }
+
+    /// The exchange memory, made on first use.
+    fn scratch(&mut self) -> Result<V, Why> {
+        let (made, total) = {
+            let em = self.emulated.as_ref().expect("emulated");
+            (em.scratch, em.total)
+        };
+        if let Some(g) = made {
+            return Ok(g);
+        }
+        let bytes = u64::from(self.s.lds_dwords) * 4 + u64::from(total) * 4;
+        if bytes > u64::from(GROUP_SHARED_LIMIT) {
+            return Err("emulated wave operations beyond the host's group-shared memory");
+        }
+        let g = self.s.wave_scratch(total);
+        self.emulated.as_mut().expect("emulated").scratch = Some(g);
+        Ok(g)
+    }
+
+    /// A thread-group sync with a group-shared fence, at the end of `at`.
+    fn group_barrier(&mut self, at: usize) {
+        let mode = self.s.m.i32(1 | 8);
+        let void = self.s.t.void;
+        self.s
+            .op(at, "barrier", Attr::NoDuplicate, void, 80, &[mode]);
+    }
+
+    /// An exchange's first half, at the end of `at` (which every thread must
+    /// run): this thread's `word` goes to its slot, between two barriers.
+    fn publish(&mut self, at: usize, word: V) -> Result<(), Why> {
+        let g = self.scratch()?;
+        let (flat, _, _) = self.console_ids();
+        self.group_barrier(at);
+        let slot = self.s.m.element(at, g, flat);
+        self.s.m.store(at, slot, word);
+        self.group_barrier(at);
+        Ok(())
+    }
+
+    /// After [`Lower::publish`]: the word lane `lane` (0 to 63) of this
+    /// thread's console wave published, `absent` for a lane past the
+    /// group's last thread (a group need not fill its last wave).
+    fn published(&mut self, at: usize, lane: V, absent: V) -> V {
+        let (flat, _, base) = self.console_ids();
+        let (g, total) = {
+            let em = self.emulated.as_ref().expect("emulated");
+            (em.scratch.expect("published"), em.total)
+        };
+        let index = self.s.m.bin(at, Bin::Add, base, lane);
+        if total % 64 == 0 {
+            let slot = self.s.m.element(at, g, index);
+            return self.s.m.load(at, slot);
+        }
+        // No load outside the array: an absent lane reads this thread's slot.
+        let n = self.s.m.i32(total);
+        let inside = self.s.m.cmp(at, pred::IULT, index, n);
+        let index = self.s.m.select(at, inside, index, flat);
+        let slot = self.s.m.element(at, g, index);
+        let word = self.s.m.load(at, slot);
+        self.s.m.select(at, inside, word, absent)
+    }
+
+    /// Console lanes a group has in any of its waves: 64, or fewer when the
+    /// whole group is smaller.
+    fn console_lanes_used(&self) -> u32 {
+        self.emulated.as_ref().expect("emulated").total.min(64)
+    }
+
+    /// The low and high dwords of the console wave's mask whose bit in this
+    /// lane is `bit`, at the end of `at` (which every thread must run).
+    fn emulated_ballot(&mut self, at: usize, bit: V) -> Result<(V, V), Why> {
+        let i32t = self.s.t.i32;
+        let word = self.s.m.cast(at, Cast::ZExt, bit, i32t);
+        self.publish(at, word)?;
+        let zero = self.s.m.i32(0);
+        let (mut lo, mut hi) = (zero, zero);
+        for k in 0..self.console_lanes_used() {
+            let lane = self.s.m.i32(k);
+            let w = self.published(at, lane, zero);
+            let sh = self.s.m.i32(k & 31);
+            let b = self.s.m.bin(at, Bin::Shl, w, sh);
+            if k < 32 {
+                lo = self.s.m.bin(at, Bin::Or, lo, b);
+            } else {
+                hi = self.s.m.bin(at, Bin::Or, hi, b);
+            }
+        }
+        Ok((lo, hi))
+    }
+
+    /// `x` of lane `lane` of this thread's console wave (0 for a lane the
+    /// group does not have).
+    // shortcut: what the console reads from a lane that does not exist is
+    // not known; no program was seen to depend on it.
+    fn emulated_read_lane(&mut self, x: V, lane: V) -> Result<V, Why> {
+        self.exchange_site()?;
+        let at = self.cur;
+        self.publish(at, x)?;
+        let (k63, zero) = (self.s.m.i32(63), self.s.m.i32(0));
+        let lane = self.s.m.bin(at, Bin::And, lane, k63);
+        Ok(self.published(at, lane, zero))
+    }
+
+    /// `x` of the first lane of this thread's console wave that runs the
+    /// instruction (of lane 0 when none does).
+    fn emulated_read_first(&mut self, x: V) -> Result<V, Why> {
+        self.exchange_site()?;
+        let at = self.cur;
+        // Every lane arriving here runs the instruction (`exchange_site`).
+        let on = self.s.m.bool(true);
+        let (lo, hi) = self.emulated_ballot(at, on)?;
+        let (zero, one) = (self.s.m.i32(0), self.s.m.i32(1));
+        let mut first = zero;
+        for k in (0..self.console_lanes_used()).rev() {
+            let word = if k < 32 { lo } else { hi };
+            let sh = self.s.m.i32(k & 31);
+            let t = self.s.m.bin(at, Bin::LShr, word, sh);
+            let t = self.s.m.bin(at, Bin::And, t, one);
+            let set = self.s.m.cmp(at, pred::NE, t, zero);
+            let lane = self.s.m.i32(k);
+            first = self.s.m.select(at, set, lane, first);
+        }
+        self.publish(at, x)?;
+        Ok(self.published(at, first, zero))
+    }
+
+    /// `op` over `x` of every lane of this thread's console wave, or with
+    /// `prefix` over the lanes below this one (and this one when inclusive).
+    fn emulated_shape(
+        &mut self,
+        op: super::wave::Op,
+        x: V,
+        prefix: Option<bool>,
+    ) -> Result<V, Why> {
+        use super::wave::Op;
+        if prefix.is_some() && !matches!(op, Op::AddU | Op::AddF) {
+            return Err("a wave prefix of an operation other than a sum");
+        }
+        self.exchange_site()?;
+        let at = self.cur;
+        self.publish(at, x)?;
+        let me = self.console_ids().1;
+        // Lanes the group lacks and lanes a prefix leaves out change nothing.
+        let none = self.s.m.i32(neutral(op));
+        let mut acc = none;
+        for k in 0..self.console_lanes_used() {
+            let lane = self.s.m.i32(k);
+            let mut w = self.published(at, lane, none);
+            if let Some(inclusive) = prefix {
+                let p = if inclusive { pred::IULE } else { pred::IULT };
+                let counts = self.s.m.cmp(at, p, lane, me);
+                w = self.s.m.select(at, counts, w, none);
+            }
+            acc = self.fold(at, op, acc, w);
+        }
+        Ok(acc)
+    }
+
+    /// `a op b` on register dwords.
+    fn fold(&mut self, at: usize, op: super::wave::Op, a: V, b: V) -> V {
+        use super::wave::Op;
+        let m = |l: &mut Self, p: u8| {
+            let first = l.s.m.cmp(at, p, a, b);
+            l.s.m.select(at, first, a, b)
+        };
+        match op {
+            Op::AddU => self.s.m.bin(at, Bin::Add, a, b),
+            Op::Or => self.s.m.bin(at, Bin::Or, a, b),
+            Op::And => self.s.m.bin(at, Bin::And, a, b),
+            Op::Xor => self.s.m.bin(at, Bin::Xor, a, b),
+            Op::MinU => m(self, pred::IULT),
+            Op::MaxU => m(self, pred::IUGT),
+            Op::MinI => m(self, pred::SLT),
+            Op::MaxI => m(self, pred::SGT),
+            Op::AddF | Op::MinF | Op::MaxF => {
+                let (i32t, f32t) = (self.s.t.i32, self.s.t.f32);
+                let fa = self.s.m.cast(at, Cast::Bitcast, a, f32t);
+                let fb = self.s.m.cast(at, Cast::Bitcast, b, f32t);
+                let r = match op {
+                    Op::AddF => self.s.m.bin(at, Bin::Add, fa, fb),
+                    // FMax 35, FMin 36.
+                    Op::MaxF => self
+                        .s
+                        .op(at, "binary.f32", Attr::ReadNone, f32t, 35, &[fa, fb]),
+                    _ => self
+                        .s
+                        .op(at, "binary.f32", Attr::ReadNone, f32t, 36, &[fa, fb]),
+                };
+                self.s.m.cast(at, Cast::Bitcast, r, i32t)
+            }
+        }
+    }
