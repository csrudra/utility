+/// A compute program whose console waves have 64 lanes, on a host whose
+/// waves may be smaller (`Parts::emulate_wave64`): no wave size is declared
+/// and no host wave operation is used. A thread's console lane is its flat
+/// index in the group modulo 64, its console wave the 64 threads sharing the
+/// quotient, as the console lays a group out. What a lane needs of the
+/// others goes through group-shared memory, one exchange per use: every
+/// thread stores a dword in its slot between two group barriers and reads
+/// the slots of its console wave after the second (the first keeps the
+/// stores off the previous exchange's reads).
+///
+/// A barrier is only defined where every thread of the group arrives, so an
+/// exchange is only made in blocks every thread runs once and outside lane
+/// guards ([`NOT_UNIFORM`] otherwise, and the program is not translated).
+// shortcut: a thread a loop's iteration limit ends (`LOOP_LIMIT`) no longer
+// arrives at later barriers.
+// shortcut: programs sharing LDS within one wave without barriers keep
+// their `WaveSize`: the two halves of an emulated wave would race.
+struct Emulated {
+    /// Per IR block: every thread of the group runs it exactly once.
+    uniform: Vec<bool>,
+    /// Threads in a group.
+    total: u32,
+    /// Made in the entry block: the flat thread index, the console lane and
+    /// the flat index of the console wave's first lane.
+    ids: Option<(V, V, V)>,
+    /// The exchange memory: a dword per thread.
+    scratch: Option<V>,
+}
+
+/// What a cross-lane operation of an emulated wave stops with where not
+/// every thread of the group arrives.
+const NOT_UNIFORM: Why = "an emulated wave operation outside uniform control flow";
+
+/// D3D12's limit on a compute shader's group-shared memory, in bytes.
+const GROUP_SHARED_LIMIT: u32 = 32768;
+
+/// Per block: whether every lane that runs the program to its end runs the
+/// block exactly once (it dominates every block the program ends in and is
+/// on no cycle). Nothing is, in a program that never ends.
+fn uniform_blocks(blocks: &[crate::ir::Block]) -> Vec<bool> {
+    let order = crate::ir::reverse_postorder(blocks);
+    let mut index = vec![usize::MAX; blocks.len()];
+    for (n, &b) in order.iter().enumerate() {
+        index[b] = n;
+    }
+    let idom = crate::ir::idoms(blocks, &order, &index);
+    let mut uniform = vec![false; blocks.len()];
+    let ends: Vec<usize> = order
+        .iter()
+        .copied()
+        .filter(|&b| blocks[b].exit.successors().is_empty())
+        .collect();
+    let Some((&first, rest)) = ends.split_first() else {
+        return uniform;
+    };
+    // A block and its dominators, from the block up to the entry.
+    let chain = |from: usize| {
+        let mut out = vec![from];
+        let mut d = from;
+        while idom[d] != d && idom[d] != usize::MAX {
+            d = idom[d];
+            out.push(d);
+        }
+        out
+    };
+    let mut common = chain(first);
+    for &e in rest {
+        let c = chain(e);
+        common.retain(|b| c.contains(b));
+    }
+    for b in common {
+        // On a cycle: the block is reachable from one of its successors.
+        let mut seen = vec![false; blocks.len()];
+        let mut stack = blocks[b].exit.successors();
+        let mut cyclic = false;
+        while let Some(n) = stack.pop() {
+            if n == b {
+                cyclic = true;
+                break;
+            }
+            if !std::mem::replace(&mut seen[n], true) {
+                stack.extend(blocks[n].exit.successors());
+            }
+        }
+        uniform[b] = !cyclic;
+    }
+    uniform
+}
+
+/// The value that leaves the other operand of `op` unchanged.
+fn neutral(op: super::wave::Op) -> u32 {
+    use super::wave::Op;
+    match op {
+        Op::AddU | Op::AddF | Op::Or | Op::Xor | Op::MaxU => 0,
+        Op::MinU | Op::And => u32::MAX,
+        Op::MinI => 0x7FFF_FFFF,
+        Op::MaxI => 0x8000_0000,
+        Op::MinF => 0x7F80_0000,
+        Op::MaxF => 0xFF80_0000,
+    }
+}
