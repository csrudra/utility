+            println!("stall watchdog +{:#x} ({}): {}", p.rva, p.what, if *ok { "off" } else { "NOT changed (bytes differ)" });
+        }
+        if patches.is_empty() {
+            println!("stall watchdog: no patches for this build");
+        }
+    }
     println!(
         "mapped at      {:#x} (preferred {:#x})",
         image.base(),
