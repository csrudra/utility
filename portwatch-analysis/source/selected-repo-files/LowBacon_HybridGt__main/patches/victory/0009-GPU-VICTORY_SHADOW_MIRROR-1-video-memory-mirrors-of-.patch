     before: Mutex<Option<(usize, Vec<u8>)>>,
+    /// HybridGt (`VICTORY_SHADOW_MIRROR=1`): the system-memory copy the CPU
+    /// works on (`data` maps it); `buffer` is then a video-memory mirror the
+    /// GPU works on. `None`: `buffer` is the system-memory copy itself.
+    staging: Option<ID3D12Resource>,
+    /// Byte ranges of `staging` the CPU changed since the mirror took them.
+    dirty: Mutex<Vec<(usize, usize)>>,
+}
+
+/// HybridGt: whether title buffer copies get video-memory mirrors
+/// (`VICTORY_SHADOW_MIRROR=1`). A discrete GPU reads system memory over
+/// PCIe (RTX 4070 Ti: 8.5 GB/s, against 278 GB/s from video memory) and
+/// the CPU reads video memory uncached; with mirrors each side works on its
+/// own memory and the copy engine moves what changed: the CPU's changes up
+/// before a submission, the ranges shaders declare written down after it.
+pub(crate) fn mirror_mode() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var("VICTORY_SHADOW_MIRROR").as_deref() == Ok("1");
+        if on {
+            tracing::warn!("VICTORY_SHADOW_MIRROR=1: title buffer copies mirrored in video memory");
+        }
+        on
+    })
+}
+
+/// Every mirrored copy, for the uploads at submission.
+static MIRRORED: Mutex<Vec<Weak<Shadow>>> = Mutex::new(Vec::new());
+
+/// HybridGt: the host buffers behind a new copy of `len` bytes: the one GPU
+/// work uses, the system-memory staging buffer when mirrored, the mapping.
+fn host_buffers(len: u64) -> Option<(ID3D12Resource, Option<ID3D12Resource>, *mut u8)> {
+    let host = host()?;
+    let (shared, data) = host.shared_buffer(len)?;
+    if !mirror_mode() {
+        return Some((shared, None, data));
+    }
+    match host.video_buffer(len) {
+        Some(mirror) => Some((mirror, Some(shared), data)),
+        None => Some((shared, None, data)),
+    }
+}
+
+/// HybridGt: records, in `list`, the copies of every mirrored copy's
+/// changed ranges into its mirror; the bytes recorded.
+pub(crate) fn upload_dirty(list: &ID3D12GraphicsCommandList) -> u64 {
+    let mut all = MIRRORED.lock().unwrap_or_else(|e| e.into_inner());
+    all.retain(|w| w.strong_count() > 0);
+    let mut bytes = 0;
+    for shadow in all.iter().filter_map(Weak::upgrade) {
+        let Some(staging) = &shadow.staging else { continue };
+        let ranges = std::mem::take(&mut *shadow.dirty.lock().unwrap_or_else(|e| e.into_inner()));
+        for (from, to) in ranges {
+            // SAFETY: an open list; both buffers are live, the range inside both.
+            unsafe { list.CopyBufferRegion(&shadow.buffer, from as u64, staging, from as u64, (to - from) as u64) };
+            bytes += (to - from) as u64;
+        }
+    }
+    bytes
+}
+
+fn register_mirror(shadow: &Arc<Shadow>) {
+    if shadow.staging.is_some() {
+        MIRRORED.lock().unwrap_or_else(|e| e.into_inner()).push(Arc::downgrade(shadow));
+    }
 }
 
