     /// it is fast too) and shaders read and write: for host copies of title
     /// memory that shaders write, which upload memory cannot be. Starts in
     /// the common state (buffers move out of it implicitly).
+    /// HybridGt: a video-memory buffer shaders may write: the mirror of a
+    /// title buffer copy (`shadow::mirror_mode`).
+    pub(crate) fn video_buffer(&self, size: u64) -> Option<ID3D12Resource> {
+        let heap = D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_DEFAULT, ..Default::default() };
+        let desc = D3D12_RESOURCE_DESC {
+            Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+            Width: size.max(1),
+            Height: 1,
+            DepthOrArraySize: 1,
+            MipLevels: 1,
+            SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+            Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+            Flags: D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+            ..Default::default()
+        };
+        let mut buffer: Option<ID3D12Resource> = None;
+        // SAFETY: plain creation of a buffer.
+        let made = unsafe {
+            self.device.CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COMMON, None, &mut buffer)
+        };
+        match made {
+            Ok(()) => buffer,
+            Err(e) => {
+                tracing::warn!(error = %e, size, "no video memory mirror; the copy stays in system memory");
+                None
+            }
+        }
+    }
+
+    /// HybridGt: records copies with `record` in a list of its own, runs it
+    /// on the queue after what was submitted before, and with `wait` waits
+    /// for it. One list and allocator, reused: submissions run one at a
+    /// time and each ends waited for.
+    fn run_copies(
+        &self,
+        submitted: &mut u64,
+        wait: bool,
+        record: impl FnOnce(&ID3D12GraphicsCommandList) -> u64,
+    ) -> u64 {
+        static LIST: Mutex<Option<(ID3D12CommandAllocator, ID3D12GraphicsCommandList)>> = Mutex::new(None);
+        let mut slot = LIST.lock().unwrap_or_else(|e| e.into_inner());
+        // SAFETY: plain object creation and recording; the allocator's last
+        // list has run (it ran before this submission's waited lists).
+        unsafe {
+            if slot.is_none() {
+                let Ok(a) = self.device.CreateCommandAllocator::<ID3D12CommandAllocator>(D3D12_COMMAND_LIST_TYPE_DIRECT)
+                else {
+                    return 0;
+                };
+                let Ok(l) = self.device.CreateCommandList::<_, _, ID3D12GraphicsCommandList>(
+                    0,
+                    D3D12_COMMAND_LIST_TYPE_DIRECT,
+                    &a,
+                    None,
+                ) else {
+                    return 0;
+                };
+                let _ = l.Close();
+                *slot = Some((a, l));
+            }
+            let Some((a, l)) = slot.as_ref() else { return 0 };
+            if a.Reset().is_err() || l.Reset(a, None).is_err() {
+                return 0;
+            }
+            let bytes = record(l);
+            if l.Close().is_err() || bytes == 0 {
+                return bytes;
+            }
+            let Ok(cl) = l.cast::<ID3D12CommandList>() else { return 0 };
+            self.queue.ExecuteCommandLists(&[Some(cl)]);
+            if wait {
+                *submitted += 1;
+                if self.queue.Signal(&self.fence, *submitted).is_ok()
+                    && self.fence.SetEventOnCompletion(*submitted, self.event).is_ok()
+                {
+                    WaitForSingleObject(self.event, INFINITE);
+                }
+            }
+            bytes
+        }
+    }
