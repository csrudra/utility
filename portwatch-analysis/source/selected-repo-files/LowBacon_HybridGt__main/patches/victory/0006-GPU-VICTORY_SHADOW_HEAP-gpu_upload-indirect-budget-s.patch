+/// HybridGt: whether `VICTORY_SHADOW_HEAP=gpu_upload` is set and the host
+/// has GPU upload heaps (logged once).
+fn shadow_heap_gpu_upload(device: &ID3D12Device) -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        if std::env::var("VICTORY_SHADOW_HEAP").as_deref() != Ok("gpu_upload") {
+            return false;
+        }
+        let mut o16 = D3D12_FEATURE_DATA_D3D12_OPTIONS16::default();
+        // SAFETY: a sized out structure.
+        let ok = unsafe {
+            device
+                .CheckFeatureSupport(
+                    D3D12_FEATURE_D3D12_OPTIONS16,
+                    (&mut o16 as *mut D3D12_FEATURE_DATA_D3D12_OPTIONS16).cast(),
+                    size_of::<D3D12_FEATURE_DATA_D3D12_OPTIONS16>() as u32,
+                )
+                .is_ok()
+        } && o16.GPUUploadHeapSupported.as_bool();
+        tracing::warn!(gpu_upload = ok, "VICTORY_SHADOW_HEAP=gpu_upload: title buffer copies in video memory");
+        ok
+    })
+}
+
+/// HybridGt (diagnostics): after a submission ran, how much of each list's
+/// indirect work budget its clamped records used. A list at the budget had
+/// records run empty: shader-written arguments past every sane size.
+#[cfg(feature = "diagnostics")]
+fn note_budgets(runs: &[&HostList]) {
+    static AT_BUDGET: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    static MAX_USED: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+    let budget = 1u64 << crate::indirect::budget_log2();
+    for list in runs {
+        let Some(Some((_, data))) = list.budget.get() else { continue };
+        // SAFETY: the list's own mapped word; its submission has run.
+        let used = unsafe { (*data as *const u32).read_volatile() };
+        let before = MAX_USED.fetch_max(used, Ordering::Relaxed);
+        if used > before && used >= 1 << 20 {
+            tracing::warn!(used, budget, "indirect work of one list: new highest");
+        }
+        if u64::from(used) >= budget {
+            let n = AT_BUDGET.fetch_add(1, Ordering::Relaxed) + 1;
+            if n.is_power_of_two() {
+                tracing::warn!(lists = n, budget, "lists that used their whole indirect work budget");
+            }
+        }
+    }
+}
