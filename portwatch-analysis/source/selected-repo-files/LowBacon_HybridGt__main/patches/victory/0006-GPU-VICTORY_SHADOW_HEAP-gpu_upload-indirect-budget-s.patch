+/// HybridGt: log2 of the per-list indirect work budget: 27, or
+/// `VICTORY_INDIRECT_BUDGET` (10..=31).
+pub(crate) fn budget_log2() -> u32 {
+    static B: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *B.get_or_init(|| {
+        std::env::var("VICTORY_INDIRECT_BUDGET")
+            .ok()
+            .and_then(|v| v.trim().parse::<u32>().ok())
+            .map_or(27, |n| n.clamp(10, 31))
+    })
+}
