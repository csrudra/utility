     pub(crate) fn shared_buffer(&self, size: u64) -> Option<(ID3D12Resource, *mut u8)> {
-        let heap = D3D12_HEAP_PROPERTIES {
-            Type: D3D12_HEAP_TYPE_CUSTOM,
-            CPUPageProperty: D3D12_CPU_PAGE_PROPERTY_WRITE_BACK,
-            MemoryPoolPreference: D3D12_MEMORY_POOL_L0,
-            ..Default::default()
+        // HybridGt: `VICTORY_SHADOW_HEAP=gpu_upload` places these buffers in
+        // CPU-writable video memory (Resizable BAR) instead of system
+        // memory, which a discrete GPU reads over PCIe: an RTX 4070 Ti
+        // reads 8.5 GB/s from L0 and 276 GB/s from GPU_UPLOAD (hgt-gfxdiag).
+        // CPU reads of it are uncached (snapshots, copy-back).
+        let heap = if shadow_heap_gpu_upload(&self.device) {
+            D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_GPU_UPLOAD, ..Default::default() }
+        } else {
+            D3D12_HEAP_PROPERTIES {
+                Type: D3D12_HEAP_TYPE_CUSTOM,
+                CPUPageProperty: D3D12_CPU_PAGE_PROPERTY_WRITE_BACK,
+                MemoryPoolPreference: D3D12_MEMORY_POOL_L0,
+                ..Default::default()
+            }
         };
         let desc = D3D12_RESOURCE_DESC {
             Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
