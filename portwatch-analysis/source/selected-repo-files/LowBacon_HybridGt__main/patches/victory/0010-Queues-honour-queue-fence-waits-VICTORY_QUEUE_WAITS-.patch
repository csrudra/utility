+/// Without `VICTORY_QUEUE_WAITS` nothing runs on the queue, so waiting for a
+/// fence never blocks it; with it, an unmet wait holds the queue.
+extern "system" fn wait(q: This, fence: This, value: u64) -> HRESULT {
+    if fence.is_null() {
+        return E_INVALIDARG;
+    }
+    if queue_waits() {
+        let met = fence_value(fence as usize) >= value;
+        // Behind earlier held work it waits its turn; on an idle queue only if unmet.
+        let _ = hold(q as usize, Held::Wait(fence as usize, value), !met);
+    }
+    S_OK
 }
 /// Ticks per second of GPU timestamps (see [`Written::GpuTimestamp`]).
