+
+// ---- HybridGt: queue waits (VICTORY_QUEUE_WAITS=1) ----
+//
+// The console's queues run their submissions in order, and a queue told to
+// wait for a fence value holds everything submitted after the wait until
+// another queue (or the CPU) signals it. Here submissions run on the host
+// when the title makes them, and `wait` did nothing, so a consumer queued
+// behind a wait ran before its producer: it read data never written.
+// With the switch, a queue whose wait is not met holds its later
+// executions, signals and waits, in order, and every fence signal runs
+// what it unblocks. A wait still unmet after WAIT_LIMIT runs its queue
+// anyway (logged), so a fence we never see signalled cannot stop the title.
+
+enum Held {
+    Execute(Vec<usize>),
+    Signal(usize, u64),
+    Wait(usize, u64),
+}
+
+/// Held work per queue (by queue address), oldest first, with when it was held.
+static HELD: std::sync::Mutex<Vec<(usize, std::collections::VecDeque<(Held, std::time::Instant)>)>> =
+    std::sync::Mutex::new(Vec::new());
+static DRAINING: AtomicBool = AtomicBool::new(false);
+const WAIT_LIMIT: std::time::Duration = std::time::Duration::from_secs(4);
+
+pub(crate) fn queue_waits() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var("VICTORY_QUEUE_WAITS").as_deref() == Ok("1");
+        if on {
+            tracing::warn!("VICTORY_QUEUE_WAITS=1: queue waits hold later submissions until their fence is signalled");
+        }
+        on
+    })
+}
+
+fn fence_value(fence: usize) -> u64 {
+    crate::fence::value(fence as This)
+}
+
+/// Holds `item` behind what queue `q` already holds; with `always`, even
+/// when it holds nothing (a wait that is not met). False: nothing held, run it now.
+fn hold(q: usize, item: Held, always: bool) -> Result<(), Held> {
+    let mut held = HELD.lock().unwrap_or_else(|e| e.into_inner());
+    let at = held.iter().position(|(k, _)| *k == q);
+    match at {
+        Some(i) if !held[i].1.is_empty() => {
+            held[i].1.push_back((item, std::time::Instant::now()));
+            Ok(())
+        }
+        _ if always => {
+            let now = std::time::Instant::now();
+            match at {
+                Some(i) => held[i].1.push_back((item, now)),
+                None => held.push((q, std::collections::VecDeque::from([(item, now)]))),
+            }
+            Ok(())
+        }
+        _ => Err(item),
+    }
+}
+
+/// The next held item some queue can run now, taken off its queue.
+fn next_runnable() -> Option<Held> {
+    let mut held = HELD.lock().unwrap_or_else(|e| e.into_inner());
+    for (q, items) in held.iter_mut() {
+        let Some((front, since)) = items.front() else { continue };
+        if let Held::Wait(fence, value) = *front {
+            let met = fence_value(fence) >= value;
+            if !met && since.elapsed() < WAIT_LIMIT {
+                continue;
+            }
+            if !met {
+                static N: AtomicU64 = AtomicU64::new(0);
+                let n = N.fetch_add(1, Ordering::Relaxed) + 1;
+                if n.is_power_of_two() {
+                    tracing::warn!(queue = format_args!("{q:#x}"), value, now = fence_value(fence), times = n, "queue wait unmet after the limit: its queue runs anyway");
+                }
+            }
+        }
+        return items.pop_front().map(|(h, _)| h);
+    }
+    None
+}
+
+/// Runs held work until nothing more is runnable (re-entrant calls return).
+pub(crate) fn drain() {
+    if !queue_waits() || DRAINING.swap(true, Ordering::AcqRel) {
+        return;
+    }
+    while let Some(item) = next_runnable() {
+        match item {
+            Held::Execute(lists) => run_lists(&lists),
+            Held::Signal(fence, value) => {
+                crate::fence::signal(fence as This, value);
+            }
+            Held::Wait(..) => {}
+        }
+    }
+    DRAINING.store(false, Ordering::Release);
+}
+
+fn run_lists(lists: &[usize]) {
+    #[cfg(windows)]
+    if let Some(host) = crate::host::host() {
+        let host_lists: Vec<_> = lists.iter().filter_map(|&l| crate::list::host_list(l as This)).collect();
+        host.execute(&host_lists);
+    }
+    #[cfg(not(windows))]
+    let _ = lists;
+}
