diff --git a/crates/victory-gpu/src/watch.rs b/crates/victory-gpu/src/watch.rs
index 7694609..581322d 100644
--- a/crates/victory-gpu/src/watch.rs
+++ b/crates/victory-gpu/src/watch.rs
@@ -35,14 +35,70 @@ struct Journal {
     written: BTreeMap<usize, u64>,
     /// Room for the kernel's answer.
     found: Vec<usize>,
+    /// HybridGt: page ranges the kernel was asked about in this epoch (one
+    /// submission's preparation), merged and in order. Asking again inside
+    /// them finds only what the title's other threads write meanwhile,
+    /// which races the submission on the console too; our own writes in
+    /// the epoch are noted by [`note_written`].
+    asked_in_epoch: Vec<(usize, usize)>,
 }
 
 static JOURNAL: Mutex<Journal> = Mutex::new(Journal {
     asked: 0,
     written: BTreeMap::new(),
     found: Vec::new(),
+    asked_in_epoch: Vec::new(),
 });
 
+/// HybridGt: whether answers are reused within a submission
+/// (`VICTORY_WATCH_EPOCH=0` turns it off).
+fn epoch_reuse() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_WATCH_EPOCH").map_or(true, |v| v != "0"))
+}
+
+/// HybridGt: starts an epoch: every range is asked about again. At each
+/// submission, and after work whose title writes are not known.
+pub(crate) fn new_epoch() {
+    JOURNAL.lock().unwrap_or_else(|e| e.into_inner()).asked_in_epoch.clear();
+}
+
+/// HybridGt: our own write of title memory `[at, at + len)` in this
+/// epoch: its pages count as written now.
+pub(crate) fn note_written(at: usize, len: usize) {
+    if len == 0 {
+        return;
+    }
+    let mut j = JOURNAL.lock().unwrap_or_else(|e| e.into_inner());
+    j.asked += 1;
+    let now = j.asked;
+    for page in at / PAGE..(at + len).div_ceil(PAGE) {
+        j.written.insert(page, now);
+    }
+}
+
+/// Whether `[first, last)` (pages) lies inside one range asked this epoch.
+fn covered(ranges: &[(usize, usize)], first: usize, last: usize) -> bool {
+    let i = ranges.partition_point(|&(a, _)| a <= first);
+    i > 0 && ranges[i - 1].1 >= last
+}
+
+/// Adds `[first, last)` to the merged, ordered ranges.
+fn add_range(ranges: &mut Vec<(usize, usize)>, first: usize, last: usize) {
+    let (mut a, mut b) = (first, last);
+    ranges.retain(|&(x, y)| {
+        if y < a || x > b {
+            true
+        } else {
+            a = a.min(x);
+            b = b.max(y);
+            false
+        }
+    });
+    let i = ranges.partition_point(|&(x, _)| x < a);
+    ranges.insert(i, (a, b));
+}
+
 /// The pages of `[start, end)` (whole pages) as last written, for pages
 /// written since tracking began: `(page number, asking)` in page order, and
 /// this asking's number, which is higher than any in the list but those the
@@ -54,6 +110,12 @@ pub(crate) fn writes(start: usize, end: usize, guarded: bool) -> Option<(u64, Ve
     let (first, last) = (start / PAGE, end.div_ceil(PAGE));
     let mut j = JOURNAL.lock().unwrap_or_else(|e| e.into_inner());
     let j = &mut *j;
+    if epoch_reuse() && covered(&j.asked_in_epoch, first, last) {
+        #[cfg(feature = "diagnostics")]
+        crate::copystat::add(crate::copystat::C::WatchReused, 1);
+        j.asked += 1;
+        return Some((j.asked, j.written.range(first..last).map(|(&p, &w)| (p, w)).collect()));
+    }
     let mut count = (last - first) * PAGE / KERNEL_PAGE;
     j.found.resize(count.max(j.found.len()), 0);
     let mut granularity = 0;
@@ -85,6 +147,9 @@ pub(crate) fn writes(start: usize, end: usize, guarded: bool) -> Option<(u64, Ve
         add(C::Watches, 1);
         add(C::WatchUs, started.elapsed().as_micros() as u64);
     }
+    if !failed && epoch_reuse() {
+        add_range(&mut j.asked_in_epoch, first, last);
+    }
     j.asked += 1;
     let now = j.asked;
     let pages = j.found[..count].iter().map(|&at| at / PAGE).chain(guarded);
@@ -379,3 +444,25 @@ mod tests {
         title_memory_remapped(top, usize::MAX);
     }
 }
+
+#[cfg(test)]
+mod epoch_tests {
+    use super::{add_range, covered};
+
+    #[test]
+    fn ranges_merge_and_cover() {
+        let mut r = Vec::new();
+        add_range(&mut r, 10, 20);
+        add_range(&mut r, 30, 40);
+        assert!(covered(&r, 12, 18));
+        assert!(covered(&r, 10, 20));
+        assert!(!covered(&r, 15, 25));
+        assert!(!covered(&r, 25, 35));
+        add_range(&mut r, 18, 32);
+        assert_eq!(r, vec![(10, 40)]);
+        assert!(covered(&r, 15, 39));
+        add_range(&mut r, 0, 5);
+        assert_eq!(r, vec![(0, 5), (10, 40)]);
+        assert!(!covered(&r, 4, 11));
+    }
+}
