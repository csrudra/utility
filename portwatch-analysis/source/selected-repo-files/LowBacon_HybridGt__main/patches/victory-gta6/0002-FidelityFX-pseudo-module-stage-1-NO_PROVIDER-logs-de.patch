diff --git a/crates/victory-hle/src/modules/ffx.rs b/crates/victory-hle/src/modules/ffx.rs
new file mode 100644
index 0000000..3c911b4
--- /dev/null
+++ b/crates/victory-hle/src/modules/ffx.rs
@@ -0,0 +1,91 @@
+//! HybridGt: AMD FidelityFX (`amd_fidelityfx_upscaler_xbox.dll`), the
+//! upscaler the title loads in its Series S configuration.
+//!
+//! The console DLL exports the FidelityFX API (`ffx_api.h`, MIT, the same
+//! five entry points as AMD's PC SDK): `ffxCreateContext`, `ffxConfigure`,
+//! `ffxQuery`, `ffxDispatch`, `ffxDestroyContext`. Each takes a chain of
+//! descriptors that start with `{ u64 type; header* next; }`. Its shaders
+//! are not in a form our translator reads, so the DLL itself cannot run.
+//!
+//! Stage 1 (this file): the module exists, so the title's `LoadLibrary`
+//! succeeds instead of failing, and every call answers
+//! `FFX_API_RETURN_ERROR_NO_PROVIDER` (no upscaler available), which the
+//! API defines for this case. The descriptor types the title asks for are
+//! logged, to write stage 2 against: the PC SDK's upscaler run on the
+//! host's own command list.
+//! shortcut: no upscaling yet; the title is told so, never told it worked.
+
+#![allow(non_snake_case)]
+
+use std::ffi::c_void;
+use std::sync::Mutex;
+
+use crate::{HleModule, hle_export};
+
+/// `FFX_API_RETURN_ERROR_NO_PROVIDER` (ffx_api.h).
+const NO_PROVIDER: u32 = 4;
+/// `FFX_API_RETURN_ERROR_PARAMETER`.
+const PARAMETER: u32 = 6;
+
+/// Logs each descriptor type in a chain once per entry point.
+fn note(entry: &'static str, desc: *const c_void) {
+    static SEEN: Mutex<Vec<(&'static str, u64)>> = Mutex::new(Vec::new());
+    let mut at = desc as *const u64;
+    for _ in 0..16 {
+        if at.is_null() {
+            break;
+        }
+        // SAFETY: the title's descriptor chain: each link starts with its
+        // type and the next link.
+        let (ty, next) = unsafe { (at.read_unaligned(), at.add(1).read_unaligned() as *const u64) };
+        let mut seen = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+        if !seen.contains(&(entry, ty)) {
+            seen.push((entry, ty));
+            tracing::warn!(entry, desc_type = format_args!("{ty:#x}"), "FidelityFX call: no upscaler provided yet (answered NO_PROVIDER)");
+        }
+        at = next;
+    }
+}
+
+pub extern "system" fn ffxCreateContext(context: *mut *mut c_void, desc: *const c_void, _mem: *const c_void) -> u32 {
+    if context.is_null() || desc.is_null() {
+        return PARAMETER;
+    }
+    note("ffxCreateContext", desc);
+    // SAFETY: the title's out pointer.
+    unsafe { context.write(std::ptr::null_mut()) };
+    NO_PROVIDER
+}
+
+pub extern "system" fn ffxDestroyContext(_context: *mut *mut c_void, _mem: *const c_void) -> u32 {
+    NO_PROVIDER
+}
+
+pub extern "system" fn ffxConfigure(_context: *mut *mut c_void, desc: *const c_void) -> u32 {
+    note("ffxConfigure", desc);
+    NO_PROVIDER
+}
+
+pub extern "system" fn ffxQuery(_context: *mut *mut c_void, desc: *mut c_void) -> u32 {
+    note("ffxQuery", desc);
+    NO_PROVIDER
+}
+
+pub extern "system" fn ffxDispatch(_context: *mut *mut c_void, desc: *const c_void) -> u32 {
+    note("ffxDispatch", desc);
+    NO_PROVIDER
+}
+
+pub(crate) fn module() -> HleModule {
+    HleModule {
+        name: "ffx",
+        dlls: &["amd_fidelityfx_upscaler_xbox.dll"],
+        exports: vec![
+            hle_export!(ffxCreateContext),
+            hle_export!(ffxDestroyContext),
+            hle_export!(ffxConfigure),
+            hle_export!(ffxQuery),
+            hle_export!(ffxDispatch),
+        ],
+    }
+}
