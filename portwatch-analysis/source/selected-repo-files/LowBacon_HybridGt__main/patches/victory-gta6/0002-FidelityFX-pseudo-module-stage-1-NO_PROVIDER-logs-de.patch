diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index 63c4de7..1fc5b73 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -6381,7 +6381,7 @@ impl<'a> Lower<'a> {
             if self.block[q].is_none() {
                 continue;
             }
-            let tail = self.tail[q].ok_or(WHY)?;
+            let tail = self.tail[q].ok_or("a descriptor chosen by control flow (a predecessor not yet lowered: a loop)")?;
             let at = self.edges.get(&(q, block)).copied().unwrap_or(tail);
             let index = match arg {
                 Source::Loaded { load, first } => {
@@ -6393,7 +6393,19 @@ impl<'a> Lower<'a> {
                 Source::Phi { block: inner, args: inner_args } if depth > 0 => {
                     self.descriptor_phi(*inner, inner_args, sampler, depth - 1)?
                 }
-                _ => return Err(WHY),
+                // HybridGt: a descriptor the code builds whose fourth dword is 0 (no channels,
+                // no format): every read through it gives 0, which is what the host heap's
+                // null slot gives (the console's way of binding nothing on some paths).
+                Source::Constant(w) if !sampler && w[3] == 0 && super::shader::view_heap_limit() != 0 => {
+                    self.s.m.i32(super::shader::view_heap_limit())
+                }
+                Source::Phi { .. } => return Err("a descriptor chosen by control flow (joins nested too deep)"),
+                _ => {
+                    if std::env::var_os("VICTORY_WAVE_WHY").is_some() {
+                        eprintln!("DESCRIPTOR-PHI incoming {arg:?} sampler={sampler}");
+                    }
+                    return Err("a descriptor chosen by control flow (an incoming descriptor of another kind)");
+                }
             };
             incoming.push((index, at));
         }
