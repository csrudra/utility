---
 crates/victory-hle/src/modules/ffx.rs   | 91 +++++++++++++++++++++++++
 crates/victory-hle/src/modules/mod.rs   |  2 +
 crates/victory-shader/src/emit/lower.rs | 16 ++++-
 3 files changed, 107 insertions(+), 2 deletions(-)
