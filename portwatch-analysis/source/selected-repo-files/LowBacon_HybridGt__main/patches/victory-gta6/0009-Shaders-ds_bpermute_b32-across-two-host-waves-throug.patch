 crates/victory-shader/src/emit/mod.rs         | 109 +++++++++++++
 .../victory-shader/src/emit/wave64_tests.rs   | 144 ++++++++++++++++++
 3 files changed, 335 insertions(+), 7 deletions(-)

diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index 4b2a513..b40febb 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -273,6 +273,9 @@ struct Lower<'a> {
     clane: Option<V>,
