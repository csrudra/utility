+/// An f32 denormal as the zero of its sign; anything else as it is.
+fn ftz(bits: u32) -> u32 {
+    if bits & 0x7F80_0000 == 0 {
+        bits & 0x8000_0000
+    } else {
+        bits
+    }
+}
