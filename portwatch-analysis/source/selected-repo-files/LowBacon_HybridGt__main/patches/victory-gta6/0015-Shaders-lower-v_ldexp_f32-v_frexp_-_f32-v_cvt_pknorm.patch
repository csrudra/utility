+        (0x16, "v_dot4_i32_i8", 8, true),
+        (0x17, "v_dot4_u32_u8", 8, false),
+        (0x19, "v_dot8_u32_u4", 4, false),
+    ] {
+        let body = vop3p(op, 0, vgpr(1), vgpr(2), vgpr(3));
+        check_op(&body, &inputs, false, what, |i| {
+            dot(i[0], i[1], i[2], bits, signed)
+        });
+    }
+}
