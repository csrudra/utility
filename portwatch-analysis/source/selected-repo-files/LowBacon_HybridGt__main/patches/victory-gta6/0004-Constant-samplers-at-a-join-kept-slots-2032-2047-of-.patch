@@ -6396,6 +6409,19 @@ impl<'a> Lower<'a> {
                 // HybridGt: a descriptor the code builds whose fourth dword is 0 (no channels,
                 // no format): every read through it gives 0, which is what the host heap's
                 // null slot gives (the console's way of binding nothing on some paths).
+                // HybridGt: a sampler the code builds as a constant: one of the slots kept
+                // at the end of every host sampler heap, the runtime writes it there.
+                Source::Constant(w) if sampler && w.len() == 4 => {
+                    let words = [w[0], w[1], w[2], w[3]];
+                    let k = words.iter().fold(0x811c_9dc5u32, |h, &x| (h ^ x).wrapping_mul(0x0100_0193)) % CONST_SAMPLERS;
+                    let slot = CONST_SAMPLER_BASE + k;
+                    match self.heap_samplers.iter().find(|s| s.0 == slot) {
+                        Some(s) if s.1 != words => return Err("two constant samplers in one reserved slot"),
+                        Some(_) => {}
+                        None => self.heap_samplers.push((slot, words)),
+                    }
+                    self.s.m.i32(slot)
+                }
                 Source::Constant(w) if !sampler && w[3] == 0 && super::shader::view_heap_limit() != 0 => {
                     self.s.m.i32(super::shader::view_heap_limit())
                 }
