diff --git a/crates/victory-gpu/src/queue.rs b/crates/victory-gpu/src/queue.rs
index 11d3a8c..dbd9beb 100644
--- a/crates/victory-gpu/src/queue.rs
+++ b/crates/victory-gpu/src/queue.rs
@@ -918,7 +918,11 @@ extern "system" fn copy_page_mappings(
         // SAFETY: the title passes `count` batches.
         unsafe { std::slice::from_raw_parts(batches, count as usize) }
     });
+    // HybridGt: the mappings of the whole call are gathered first and made
+    // under one taking of the mapper's locks (`page_mapper_batch`), in the
+    // same order; one a page took the locks thousands of times a frame.
     let mut ok = true;
+    let mut ops: Vec<(u64, u64, u64)> = Vec::new();
     for b in batches.into_iter().flatten() {
         if b.ranges.is_null() {
             continue;
@@ -930,16 +934,20 @@ extern "system" fn copy_page_mappings(
             let len = u64::from(r.count) * PAGE;
             let inside = |pages: u32| r.start.checked_add(pages).is_some_and(|e| e <= pool_pages);
             let source = pool + u64::from(r.start) * PAGE;
-            ok &= match r.kind {
-                0 if inside(r.count) => map(at, source, len),
-                1 if inside(1) => (0..u64::from(r.count)).all(|k| map(at + k * PAGE, source, PAGE)),
-                2 => map(at, 0, len),
-                3 => true,
-                _ => false,
-            };
+            match r.kind {
+                0 if inside(r.count) => ops.push((at, source, len)),
+                1 if inside(1) => ops.extend((0..u64::from(r.count)).map(|k| (at + k * PAGE, source, PAGE))),
+                2 => ops.push((at, 0, len)),
+                3 => {}
+                _ => ok = false,
+            }
             at += len;
         }
     }
+    ok &= match crate::resource::page_mapper_batch() {
+        Some(batch) => batch(&ops),
+        None => ops.iter().fold(true, |ok, &(to, from, len)| map(to, from, len) && ok),
+    };
     if !ok {
         static ONCE: std::sync::Once = std::sync::Once::new();
         ONCE.call_once(|| tracing::warn!(pool = format_args!("{pool:#x}"), "a page mapping failed"));
diff --git a/crates/victory-gpu/src/resource.rs b/crates/victory-gpu/src/resource.rs
index 244a76c..59b7dd0 100644
--- a/crates/victory-gpu/src/resource.rs
+++ b/crates/victory-gpu/src/resource.rs
@@ -945,6 +945,22 @@ pub(crate) fn page_mapper() -> Option<PageMapper> {
     PAGE_MAPPER.get().copied()
 }
 
+/// HybridGt: the runtime's page mapper for a whole page-mapping call, each
+/// `(to, from, len)` as [`PageMapper`] takes them, under one taking of its
+/// locks.
+pub type PageMapperBatch = fn(&[(u64, u64, u64)]) -> bool;
+
+static PAGE_MAPPER_BATCH: std::sync::OnceLock<PageMapperBatch> = std::sync::OnceLock::new();
+
+/// HybridGt: see [`PageMapperBatch`].
+pub fn use_page_mapper_batch(mapper: PageMapperBatch) {
+    let _ = PAGE_MAPPER_BATCH.set(mapper);
+}
+
+pub(crate) fn page_mapper_batch() -> Option<PageMapperBatch> {
+    PAGE_MAPPER_BATCH.get().copied()
+}
+
 /// Allocation attributes for resource memory: allocator id, page size
 /// (bits 14-15: 2 MiB pages from 2 MiB up, else 64 KiB), alignment as log2
 /// (bits 24-28) and memory type (bits 29-32: write-combined for GPU-only
diff --git a/crates/victory-gpu/src/watch.rs b/crates/victory-gpu/src/watch.rs
index 89d49ed..7b59bb3 100644
--- a/crates/victory-gpu/src/watch.rs
+++ b/crates/victory-gpu/src/watch.rs
@@ -911,7 +911,14 @@ impl Drop for Remapping {
 /// the runtime asked to map or unmap under it ([`title_memory_remap_pages`]),
 /// then the calls that found their pages mapped as asked already and changed
 /// nothing.
-pub static REMAPS: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+pub static REMAPS: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+
+/// HybridGt: microseconds the runtime's mapping work spent in system calls
+/// (`system`) and in telling the GPU side what changed (`told`).
+pub fn title_memory_remap_time(system: u64, told: u64) {
+    REMAPS[5].fetch_add(system, Ordering::Relaxed);
+    REMAPS[6].fetch_add(told, Ordering::Relaxed);
+}
 
 /// HybridGt: the runtime's mapping calls count their pages here, and the
 /// calls that found nothing to change (`unchanged`).
diff --git a/crates/victory-hle/src/modules/d3d12x.rs b/crates/victory-hle/src/modules/d3d12x.rs
index abda4a6..ff2f7b3 100644
