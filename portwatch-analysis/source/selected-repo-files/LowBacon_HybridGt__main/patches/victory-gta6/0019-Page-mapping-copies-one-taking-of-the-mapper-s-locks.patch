diff --git a/crates/victory-hle/src/modules/xmem.rs b/crates/victory-hle/src/modules/xmem.rs
index 13c8167..59828f5 100644
--- a/crates/victory-hle/src/modules/xmem.rs
+++ b/crates/victory-hle/src/modules/xmem.rs
@@ -784,29 +784,69 @@ pub extern "system" fn XMemMapPhysicalPagesScatter(
 /// the title maps pages into a pool view, then has the GPU map them into its tiled
 /// heap. Page by page; false if a source page is not mapped physical memory.
 pub fn map_alias(to: u64, from: u64, len: u64) -> bool {
-    let (to, from, len) = (to as usize, from as usize, len as usize);
     let mut physical = physical();
     // As in `XMemMapPhysicalPages`: no read in place meets the gap.
     let _changing = victory_gpu::title_memory_remapping();
-    unmap(&mut physical, to, len);
+    map_alias_locked(&mut physical, to as usize, from as usize, len as usize)
+}
+
+/// HybridGt: [`map_alias`] for every `(to, from, len)` of one page-mapping
+/// call, under the two locks taken once (the queue's page-mapping copies
+/// map a constant page over a range page by page: thousands of lock
+/// round trips a frame while the world streams). True if all mapped.
+pub fn map_alias_batch(ops: &[(u64, u64, u64)]) -> bool {
+    let mut physical = physical();
+    let _changing = victory_gpu::title_memory_remapping();
+    let mut ok = true;
+    for &(to, from, len) in ops {
+        ok &= map_alias_locked(&mut physical, to as usize, from as usize, len as usize);
+    }
+    ok
+}
+
+/// The slice of a section shown at `at`, if a view shows one there.
+fn slice_at(physical: &Physical, at: usize) -> Option<Slice> {
+    physical
+        .views
+        .range(..=at)
+        .next_back()
+        .filter(|(base, (size, _))| at < *base + size)
+        .map(|(base, (_, s))| Slice {
+            index: s.index + (at - base) / PAGE,
+            section: s.section.clone(),
+        })
+}
+
+/// The work of [`map_alias`] under its locks. HybridGt: a range that shows
+/// what `from` shows already, page for page, is left as it is (the same
+/// physical pages: nothing the title can see changes), and so is an unmap
+/// of a range nothing is mapped in.
+fn map_alias_locked(physical: &mut Physical, to: usize, from: usize, len: usize) -> bool {
+    let pages = len.div_ceil(PAGE);
+    let same = |a: &Slice, b: &Slice| Arc::ptr_eq(&a.section, &b.section) && a.index == b.index;
+    let unchanged = if from == 0 {
+        // Views do not overlap: the last one starting before the end is the
+        // only one that can reach into the range.
+        physical.views.range(..to + len).next_back().is_none_or(|(base, (size, _))| base + size <= to)
+    } else {
+        (0..pages).all(|k| match (slice_at(physical, from + k * PAGE), slice_at(physical, to + k * PAGE)) {
+            (Some(a), Some(b)) => same(&a, &b),
+            _ => false,
+        })
+    };
+    victory_gpu::title_memory_remap_pages(pages, unchanged);
+    if unchanged {
+        return true;
+    }
+    unmap(physical, to, len);
     for k in (0..len).step_by(PAGE) {
         if from == 0 {
             break;
         }
-        let at = from + k;
-        let Some(slice) = physical
-            .views
-            .range(..=at)
-            .next_back()
-            .filter(|(base, (size, _))| at < *base + size)
-            .map(|(base, (_, s))| Slice {
-                index: s.index + (at - base) / PAGE,
-                section: s.section.clone(),
-            })
-        else {
+        let Some(slice) = slice_at(physical, from + k) else {
             return false;
         };
-        if !map(&mut physical, to + k, PAGE, slice) {
+        if !map(physical, to + k, PAGE, slice) {
             return false;
         }
     }
@@ -819,6 +859,7 @@ fn map(physical: &mut Physical, base: usize, len: usize, slice: Slice) -> bool {
     // SAFETY: splits the placeholder around the range (failing harmlessly
     // when the range is the whole placeholder), then maps the section
     // there; both act only on placeholders.
+    let started = std::time::Instant::now();
     let view = unsafe {
         VirtualFree(
             base as *mut c_void,
@@ -851,10 +892,12 @@ fn map(physical: &mut Physical, base: usize, len: usize, slice: Slice) -> bool {
         unsafe { UnmapViewOfFile2(GetCurrentProcess(), view, MEM_PRESERVE_PLACEHOLDER) };
         return false;
     }
+    let system = started.elapsed();
     // New contents, read-write: the GPU side's copies no longer guard it.
     victory_gpu::title_memory_remapped(base, len);
     // What the range shows now, for the GPU side's in-place census.
     victory_gpu::title_memory_view(base, len, slice.section.0 as usize, (slice.index * PAGE) as u64);
+    victory_gpu::title_memory_remap_time(system.as_micros() as u64, (started.elapsed() - system).as_micros() as u64);
     for k in 0..len.div_ceil(PAGE) {
         physical.shown.entry(slice.key(k)).or_default().push(base + k * PAGE);
     }
@@ -945,7 +988,9 @@ fn unmap(physical: &mut Physical, base: usize, len: usize) {
                 }
             }
         }
+        let told = std::time::Instant::now();
         victory_gpu::title_memory_remapped(at, size);
+        let system = std::time::Instant::now();
         // SAFETY: a view we mapped; it becomes a placeholder again.
         unsafe {
             UnmapViewOfFile2(
@@ -956,6 +1001,7 @@ fn unmap(physical: &mut Physical, base: usize, len: usize) {
                 MEM_PRESERVE_PLACEHOLDER,
             )
         };
+        victory_gpu::title_memory_remap_time(system.elapsed().as_micros() as u64, (system - told).as_micros() as u64);
         if at < base {
             map(physical, at, base - at, slice.clone());
         }
