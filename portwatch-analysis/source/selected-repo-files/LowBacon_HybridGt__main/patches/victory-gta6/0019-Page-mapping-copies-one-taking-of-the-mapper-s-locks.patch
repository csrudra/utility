From: LowBacon <lenni.a.jokitalo@gmail.com>
Date: Wed, 25 Nov 2026 11:29:55 +0200
Subject: [PATCH 19/25] Page-mapping copies: one taking of the mapper's locks
 per CopyPageMappingsBatchX call, no-op aliases skipped; remap timers split
 system calls from GPU-side notifications (HybridGt)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/victory-gpu/src/host.rs           | 10 ++--
 crates/victory-gpu/src/lib.rs            |  2 +-
 crates/victory-gpu/src/queue.rs          | 22 ++++---
 crates/victory-gpu/src/resource.rs       | 16 +++++
 crates/victory-gpu/src/watch.rs          |  9 ++-
 crates/victory-hle/src/modules/d3d12x.rs |  1 +
 crates/victory-hle/src/modules/xmem.rs   | 74 +++++++++++++++++++-----
 7 files changed, 107 insertions(+), 27 deletions(-)

diff --git a/crates/victory-gpu/src/host.rs b/crates/victory-gpu/src/host.rs
index 62df3c4..017dfa8 100644
--- a/crates/victory-gpu/src/host.rs
+++ b/crates/victory-gpu/src/host.rs
@@ -6417,13 +6417,15 @@ impl Meter {
                      hold still (the runtime remapping it); the rest is reading, hashing and detiling"
                 );
             }
-            let [taken, wait, held, pages, unchanged] =
-                [0, 1, 2, 3, 4].map(|i| crate::watch::REMAPS[i].swap(0, Ordering::Relaxed) as f64 / frames);
+            let [taken, wait, held, pages, unchanged, system, told] =
+                [0, 1, 2, 3, 4, 5, 6].map(|i| crate::watch::REMAPS[i].swap(0, Ordering::Relaxed) as f64 / frames);
             if taken > 0.0 {
                 tracing::info!(
-                    "title memory remapping per frame: the lock taken {taken:.1} times, {:.1} ms waiting for it, {:.1} ms held,                      {pages:.0} pages mapped or unmapped, {unchanged:.1} calls found them as asked already",
+                    "title memory remapping per frame: the lock taken {taken:.1} times, {:.1} ms waiting for it, {:.1} ms held,                      {pages:.0} pages mapped or unmapped, {unchanged:.1} calls found them as asked already; of the held time                      {:.1} ms in system calls, {:.1} ms telling the GPU side",
                     wait / 1000.0,
-                    held / 1000.0
+                    held / 1000.0,
+                    system / 1000.0,
+                    told / 1000.0
                 );
             }
             let [through, left] = [0, 1].map(|i| crate::texture::UNLOCKED[i].swap(0, Ordering::Relaxed) as f64 / frames);
