+/// HybridGt: whether `[base, base + pages.len() pages)` shows exactly `pages`
+/// already, page for page (the title asks again for what is there).
+fn shows_already(physical: &Physical, base: usize, pages: &[usize]) -> bool {
+    pages.iter().enumerate().all(|(k, page)| {
+        let at = base + k * PAGE;
+        let Some(want) = physical.pages.get(page) else { return false };
+        physical
+            .views
+            .range(..=at)
+            .next_back()
+            .filter(|(view, (size, _))| at < **view + size)
+            .is_some_and(|(view, (_, s))| {
+                Arc::ptr_eq(&s.section, &want.section) && s.index + (at - view) / PAGE == want.index
+            })
+    })
+}
+
+/// The work of [`XMemMapPhysicalPages`] under its locks (`physical` and the
+/// GPU side's remapping lock, both held by the caller): `n` pages at `base`,
+/// `None` unmaps. False if a page or the host fails.
+///
+/// HybridGt: a range that shows the asked pages already is left as it is:
+/// mapping the same physical page at the same address again changes nothing
+/// the title can see (the pages are the memory), where unmapping and mapping
+/// it again cost four system calls a view and told the GPU side the range
+/// was new.
+fn map_pages(physical: &mut Physical, base: usize, n: usize, pages: Option<&[usize]>) -> bool {
+    if let Some(pages) = pages
+        && shows_already(physical, base, pages)
+    {
+        victory_gpu::title_memory_remap_pages(n, true);
+        return true;
+    }
+    victory_gpu::title_memory_remap_pages(n, false);
+    unmap(physical, base, n * PAGE);
+    let Some(pages) = pages else {
+        return true;
+    };
     let mut i = 0;
     while i < n {
         let Some(first) = physical.pages.get(&pages[i]).cloned() else {
             tracing::warn!(page = pages[i], "XMemMapPhysicalPages: unknown page");
-            return std::ptr::null_mut();
+            return false;
         };
         // One view per run of consecutive slices of one section.
         let run = 1 + pages[i + 1..]
@@ -697,16 +737,23 @@ pub extern "system" fn XMemMapPhysicalPages(
                 })
             })
             .count();
-        if !map(&mut physical, base + i * PAGE, run * PAGE, first) {
-            return std::ptr::null_mut();
+        if !map(physical, base + i * PAGE, run * PAGE, first) {
+            return false;
         }
         i += run;
     }
-    address
+    true
 }
 
 /// One page at each address; null `pages`, or a page number 0, unmaps
 /// (the title passes 0 for addresses to clear).
+///
+/// HybridGt: the locks are taken once for the whole call, not once a page,
+/// and addresses that follow one another, all mapping or all unmapping, go
+/// to [`map_pages`] as one range (whose consecutive pages of one section
+/// become one view). Each page was a call of its own before: the title's
+/// streaming threads asked for the remapping lock thousands of times a
+/// frame while texture refreshes held it to read, and both waited.
 pub extern "system" fn XMemMapPhysicalPagesScatter(
     addresses: *const *mut c_void,
     n: usize,
@@ -715,21 +762,38 @@ pub extern "system" fn XMemMapPhysicalPagesScatter(
     if addresses.is_null() {
         return 0;
     }
-    for i in 0..n {
-        // SAFETY: the title passes `n` addresses and, unless null, `n` pages.
-        let (address, page) = unsafe {
-            (
-                *addresses.add(i),
-                if pages.is_null() || *pages.add(i) == 0 {
-                    std::ptr::null()
-                } else {
-                    pages.add(i)
-                },
-            )
+    // SAFETY: the title passes `n` addresses and, unless null, `n` pages.
+    let addresses = unsafe { std::slice::from_raw_parts(addresses, n) };
+    let page = |i: usize| -> Option<usize> {
+        // SAFETY: as above.
+        let p = if pages.is_null() { 0 } else { unsafe { *pages.add(i) } };
+        (p != 0).then_some(p)
+    };
+    let mut physical = physical();
+    let _changing = victory_gpu::title_memory_remapping();
+    let mut i = 0;
+    let mut run_pages = Vec::new();
+    while i < n {
+        let base = addresses[i] as usize;
+        let mapping = page(i).is_some();
+        let mut len = 1;
+        while i + len < n
+            && addresses[i + len] as usize == base + len * PAGE
+            && page(i + len).is_some() == mapping
+        {
+            len += 1;
+        }
+        let ok = if mapping {
+            run_pages.clear();
+            run_pages.extend((i..i + len).filter_map(page));
+            map_pages(&mut physical, base, len, Some(&run_pages))
+        } else {
+            map_pages(&mut physical, base, len, None)
         };
-        if XMemMapPhysicalPages(address, 1, page).is_null() {
+        if !ok {
             return 0;
         }
+        i += len;
     }
     1
 }
