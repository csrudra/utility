+#[cfg(test)]
+mod merge_log_tests {
+    use super::MergeLog;
+
+    /// A run's bytes become (dword, byte mask) entries, each dword once with
+    /// its masks joined; pending runs are unseen by every fetch, sent ones
+    /// by fetches sent before their send, pruned ones by none.
+    #[test]
+    fn entries_masks_and_what_a_fetch_did_not_see() {
+        let mut log = MergeLog::default();
+        log.add(5, 2); // bytes 5, 6: dword 4, bytes 1 and 2
+        log.add(7, 3); // bytes 7..10: dword 4 byte 3, dword 8 bytes 0 and 1
+        log.add(100, 1);
+        assert_eq!(log.unseen(0, 200, 0), vec![(5, 7), (7, 10), (100, 101)]);
+        assert_eq!(log.unseen(8, 9, 0), vec![(7, 10)]);
+        assert_eq!(log.unseen(10, 100, 0), Vec::<(usize, usize)>::new());
+        let entries = log.take(4);
+        assert_eq!(entries, vec![(4, 0xFFFF_FF00), (8, 0x0000_FFFF), (100, 0x0000_00FF)]);
+        // Sent as 4: a fetch sent after send 3 did not see them, one after 4 did.
+        assert_eq!(log.unseen(0, 200, 3).len(), 3);
+        assert!(log.unseen(0, 200, 4).is_empty());
+        // The same bytes again, pending: unseen by all until sent and pruned.
+        log.add(5, 1);
+        assert_eq!(log.unseen(0, 200, 9), vec![(5, 6)]);
+        assert_eq!(log.take(6), vec![(4, 0x0000_FF00)]);
+        log.prune(4);
+        assert_eq!(log.unseen(0, 200, 0), vec![(5, 6)]);
+        log.prune(6);
+        assert!(log.unseen(0, 200, 0).is_empty());
+        assert!(log.take(7).is_empty());
+    }
+
+    /// Entries for one dword from two runs added apart are joined.
+    #[test]
+    fn a_dword_from_two_runs_is_one_entry() {
+        let mut log = MergeLog::default();
+        log.add(64, 1);
+        log.add(200, 1);
+        log.add(66, 1);
+        assert_eq!(log.take(1), vec![(64, 0x00FF_00FF), (200, 0xFF)]);
+    }
+}
