+/// HybridGt: at a send numbered `sent_as`, per copy in the card's memory with
+/// pending merges: the shader's entries and the 64 KiB pieces they touch
+/// (spans to hash again after the merge). Runs of sends a merged fetch has
+/// passed are forgotten here too.
+pub(crate) fn card_merges(sent_as: u64) -> Vec<(Arc<Shadow>, Vec<(u32, u32)>, Vec<(usize, usize)>)> {
+    let fetched = RELAY_FETCHED.load(Ordering::Acquire);
+    let carded = CARDED.lock().unwrap_or_else(|e| e.into_inner());
+    let mut out = Vec::new();
+    for weak in carded.iter() {
+        let Some(shadow) = weak.upgrade() else {
+            continue;
+        };
+        let Some(card) = shadow.card.as_ref() else {
+            continue;
+        };
+        let entries = {
+            let _side = shadow.before.lock().unwrap_or_else(|e| e.into_inner());
+            let mut log = card.merges.lock().unwrap_or_else(|e| e.into_inner());
+            log.prune(fetched);
+            if log.pending.is_empty() {
+                continue;
+            }
+            log.take(sent_as)
+        };
+        let mut spans: Vec<(usize, usize)> = Vec::new();
+        for &(dword, _) in &entries {
+            let piece = dword as usize / PAGE * PAGE;
+            match spans.last_mut() {
+                Some(last) if last.1 >= piece => last.1 = last.1.max(piece + PAGE),
+                _ => spans.push((piece, piece + PAGE)),
+            }
+        }
+        let size = card.size as usize;
+        for span in &mut spans {
+            span.1 = span.1.min(size);
+        }
+        out.push((shadow, entries, spans));
+    }
+    out
+}
