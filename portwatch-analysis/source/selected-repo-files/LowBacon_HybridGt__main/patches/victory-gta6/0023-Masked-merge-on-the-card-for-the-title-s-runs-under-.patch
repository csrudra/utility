+/// HybridGt: whether the title's bytes put in under shader writes go to a
+/// copy in the card's memory through one masked merge on the card per send
+/// (`VICTORY_GPU_MERGE=1`, with [`relay`] and the merge's pipeline made):
+/// the title's CPU writes 85,000-102,000 runs a frame of 2-3 bytes each
+/// into pages flights' shaders write (run next12); one copy per run
+/// allowed 512 a submission, and past them the submission waited for every
+/// flight (77 ms a frame).
+pub(crate) fn gpu_merge_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| relay() && std::env::var_os("VICTORY_GPU_MERGE").is_some_and(|v| v == "1"))
+        && crate::host::card_merge_ready()
+}
+
+/// HybridGt: the masked merge's state for one copy in the card's memory.
+///
+/// `pending`: what the next send takes, as (dword offset, byte mask) for the
+/// shader, which takes each masked byte from the CPU's side. `runs`: every
+/// merged byte run not yet known landed, by first offset, with its end and
+/// the number of the send that took it (`u64::MAX` while pending). The
+/// copy-back skips those of them sent after its fetch, as it skips `sent`
+/// (`Shadow::card_merge_relay`): bytes the card had not received when it
+/// was read would otherwise be taken for the shaders'.
+#[derive(Default)]
+pub(crate) struct MergeLog {
+    pending: Vec<(u32, u32)>,
+    pending_keys: Vec<(usize, u64)>,
+    /// By (first offset, the run's own number): a run merged again before
+    /// the earlier one is forgotten is a run of its own, as `sent` keeps it.
+    runs: BTreeMap<(usize, u64), (usize, u64)>,
+    next: u64,
+    longest: usize,
+    by_send: std::collections::VecDeque<(u64, Vec<(usize, u64)>)>,
+}
+
+impl MergeLog {
+    /// Bytes `[from, from + len)` of the copy are the title's on the CPU's
+    /// side and go to the card's side at the next send, those bytes only.
+    pub(crate) fn add(&mut self, from: usize, len: usize) {
+        if len == 0 {
+            return;
+        }
+        for byte in from..from + len {
+            let dword = (byte & !3) as u32;
+            let bit = 0xFFu32 << ((byte & 3) * 8);
+            match self.pending.last_mut() {
+                Some(last) if last.0 == dword => last.1 |= bit,
+                _ => self.pending.push((dword, bit)),
+            }
+        }
+        self.next += 1;
+        let key = (from, self.next);
+        self.runs.insert(key, (from + len, u64::MAX));
+        self.pending_keys.push(key);
+        self.longest = self.longest.max(len);
+    }
+
+    /// At a send numbered `sent_as`: the entries for the shader, each dword
+    /// once (its masks joined), and the pending runs now numbered.
+    pub(crate) fn take(&mut self, sent_as: u64) -> Vec<(u32, u32)> {
+        let mut entries = std::mem::take(&mut self.pending);
+        entries.sort_unstable_by_key(|e| e.0);
+        entries.dedup_by(|b, a| {
+            if a.0 == b.0 {
+                a.1 |= b.1;
+                true
+            } else {
+                false
+            }
+        });
+        let keys = std::mem::take(&mut self.pending_keys);
+        for key in &keys {
+            if let Some(run) = self.runs.get_mut(key)
+                && run.1 == u64::MAX
+            {
+                run.1 = sent_as;
+            }
+        }
+        if !keys.is_empty() {
+            self.by_send.push_back((sent_as, keys));
+        }
+        entries
+    }
+
+    /// Forgets the runs of sends up to `fetched` (a fetch sent after them
+    /// has been merged: no copy-back reads the card from before them).
+    pub(crate) fn prune(&mut self, fetched: u64) {
+        while let Some((sent, _)) = self.by_send.front() {
+            if *sent > fetched {
+                break;
+            }
+            let (sent, keys) = self.by_send.pop_front().unwrap_or_default();
+            for key in keys {
+                if self.runs.get(&key).is_some_and(|run| run.1 == sent) {
+                    self.runs.remove(&key);
+                }
+            }
+        }
+        if self.runs.is_empty() {
+            self.longest = 0;
+        }
+    }
+
+    /// The runs overlapping `[from, to)` that a fetch sent after send
+    /// `fetched_after` did not see on the card (pending ones included).
+    pub(crate) fn unseen(&self, from: usize, to: usize, fetched_after: u64) -> Vec<(usize, usize)> {
+        self.runs
