+/// into its card side and the others stay as the card has them. Each dword
+/// is in one entry (`MergeLog::take`), so no two threads touch one.
+pub(crate) const CARD_MERGE: &str = r#"
+#define RS "RootConstants(num32BitConstants=3, b0), SRV(t0), SRV(t1), UAV(u0)"
+cbuffer C : register(b0) { uint count; uint size; uint first; };
+ByteAddressBuffer side : register(t0);
+ByteAddressBuffer entries : register(t1);
+RWByteAddressBuffer card : register(u0);
+[RootSignature(RS)]
+[numthreads(64, 1, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+    uint i = first + id.x;
+    if (i >= count) return;
+    uint2 e = entries.Load2(i * 8);
+    if (e.x + 4 > size) return;
+    uint now = side.Load(e.x);
+    uint was = card.Load(e.x);
+    card.Store(e.x, (was & ~e.y) | (now & e.y));
+}
